# Google OAuth 설정 (실제 교사 구글 계정 로그인 연동)
AUTH_SECRET="replace-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# 선택: 클라이언트 측 Google One-Tap / Identity Services 연동 시 사용
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# 선택: Neon PostgreSQL 연결 문자열 (설정 시 서버리스 Postgres에 교사별/반별 영상 DB 영구 저장, 미설정 시 로컬 JSON/메모리 스토리지 자동 폴백)
DATABASE_URL="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 선택: OpenAI API Key (동영상 스크랩 시 AI 메타데이터/주제 자동 분류 보조용, 서버 전용)
OPENAI_API_KEY=""
